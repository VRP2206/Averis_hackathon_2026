# Copy to .env and fill in. Everything is optional: with no LLM the pipeline
# runs on rules + heuristics only.

# none | anthropic | bedrock | gemini
SDOC_LLM_PROVIDER=none

# For SDOC_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# For SDOC_LLM_PROVIDER=gemini (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# For SDOC_LLM_PROVIDER=bedrock (uses your AWS credentials / IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SDOC_BEDROCK_REGION=us-east-1

# Paths (defaults point at the folders in this repo)
# SDOC_DATA_DIR=Provided Information/Participant Info
# SDOC_GROUND_TRUTH=Provided Information/Other/data_v2/ground_truth.json

# Frontend only: 21st.dev component key (never commit the real value)
TWENTYFIRST_API_KEY=
